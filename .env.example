GROQ_API_KEY=
# Check current names at https://console.groq.com/docs/models
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
# true = serve cached Groq responses for already-seen clips/prompts
DEMO_MODE=false

# Teacher sign-in (required). PIN: at least 6 characters, share only with teachers.
TEACHER_PIN=
# Signs teacher tokens (required, 32+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AKSHAR_SECRET=

# Optional
# CORS_ORIGINS=http://localhost:5173          (comma-separated frontend origins)
# AKSHAR_DB_URL=sqlite:///path/to/akshar.db
# AKSHAR_STORAGE=/path/to/storage             (audio clips)
# AKSHAR_API_DOCS=false                       (true = serve /api/docs; keep off in production)
